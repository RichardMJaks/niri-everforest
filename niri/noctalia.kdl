layout {

    focus-ring {
        active-color   "#61dbb7"
        inactive-color "#0a1519"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#61dbb7"
        inactive-color "#0a1519"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#61dbb7"
        inactive-color "#167458"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#61dbb780"
    }
}

recent-windows {
    highlight {
        active-color "#61dbb7"
        urgent-color "#ffb4ab"
    }
}
